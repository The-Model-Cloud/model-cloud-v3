rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is a participant of a thread
    function isParticipant(threadData) {
      return request.auth.uid in threadData.participants;
    }

    // Helper: Get the requesting user's role from their user document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: Check if user is a super admin
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == "super admin";
    }

    // Helper: Check if user is an admin (admin or super admin)
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == "admin" || getUserRole() == "super admin");
    }

    // Helper: Check if user is a model
    function isModel() {
      return isAuthenticated() && getUserRole() == "model";
    }

    // Helper: Get the requesting user's organisationId
    function getUserOrganisationId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationId;
    }

    // Helper: Check if user belongs to an organisation
    function hasOrganisation() {
      return isAuthenticated() && getUserOrganisationId() != null;
    }

    // Helper: Check if user is in the same organisation as the job
    function isInJobOrganisation(jobData) {
      return hasOrganisation() && jobData.organisationId == getUserOrganisationId();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSuperAdmin();

      // User notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    // Helper: Check if user is an account manager (any organisation)
    function isAccountManager() {
      return isAuthenticated() && getUserRole() == "account manager";
    }

    // Jobs collection
    // Users can read jobs they own, applied to, are invited to, or belong to their organisation
    match /jobs/{jobId} {
      allow read: if isAuthenticated() && (
        // Job owner can read
        resource.data.userId == request.auth.uid ||
        // Organisation members can read organisation jobs
        isInJobOrganisation(resource.data) ||
        // Account managers can read jobs from their organisation
        (isAccountManager() && isInJobOrganisation(resource.data)) ||
        // Admins can read all
        isAdmin() ||
        // Public jobs (for browse page) - only open jobs
        (resource.data.status == null || resource.data.status == "open")
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        // Job owner can update
        resource.data.userId == request.auth.uid ||
        // Account managers can update jobs from their organisation
        (isAccountManager() && isInJobOrganisation(resource.data)) ||
        // Admins can update any
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        // Job owner can delete
        resource.data.userId == request.auth.uid ||
        // Admins can delete any
        isAdmin()
      );

      // Job applications subcollection
      match /applications/{applicationId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Job invitations subcollection
      match /invitations/{invitationId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }

    // ============================================================================
    // FAVOURITES - Lists and Model Collections
    // ============================================================================

    // Helper: Get user's team ID
    function getUserTeamId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId;
    }

    // Helper: Check if user is in the same team as the list
    function isInListTeam(listData) {
      return isAuthenticated() &&
        listData.teamId != null &&
        getUserTeamId() == listData.teamId;
    }

    // Helper: Check if user is in the same organisation as the list
    function isInListOrganisation(listData) {
      return isAuthenticated() &&
        listData.organisationId != null &&
        getUserOrganisationId() == listData.organisationId;
    }

    // Favourite Lists collection
    match /favouriteLists/{listId} {
      // Read rules:
      // - Personal lists: owner can read
      // - Organisation lists: all org members can read
      // - Team lists: all team members can read
      // - Shared/public lists: authenticated users or anyone
      // - Admins can read all
      allow read: if
        // Owner can always read their lists
        (isAuthenticated() && resource.data.ownerId == request.auth.uid)
        // Organisation members can read organisation lists
        || (isAuthenticated() && resource.data.ownerType == "organisation" && isInListOrganisation(resource.data))
        // Team members can read team lists
        || (isAuthenticated() && resource.data.ownerType == "team" && isInListTeam(resource.data))
        // Shared lists visible to authenticated users
        || (isAuthenticated() && resource.data.visibility == "authenticated")
        // Public lists visible to anyone
        || resource.data.visibility == "public"
        // Admins can read all
        || isAdmin();

      // Create rules:
      // - Personal lists: user sets themselves as owner
      // - Organisation lists: user must be in the organisation
      // - Team lists: user must be in the team
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && (
          // Personal list
          (request.resource.data.ownerType == null || request.resource.data.ownerType == "user")
          // Organisation list - user must be in the organisation
          || (request.resource.data.ownerType == "organisation" && isInListOrganisation(request.resource.data))
          // Team list - user must be in the team
          || (request.resource.data.ownerType == "team" && isInListTeam(request.resource.data))
        );

      // Update rules:
      // - Personal lists: owner can update
      // - Organisation lists: org members can update (could restrict to admin/owner later)
      // - Team lists: team members can update
      // - Admins can update any
      allow update: if isAuthenticated()
        && (
          // Owner can update their lists
          resource.data.ownerId == request.auth.uid
          // Organisation members can update org lists
          || (resource.data.ownerType == "organisation" && isInListOrganisation(resource.data))
          // Team members can update team lists
          || (resource.data.ownerType == "team" && isInListTeam(resource.data))
          // Admins can update any
          || isAdmin()
        );

      // Delete rules:
      // - Personal lists: owner can delete
      // - Organisation lists: org admins/owners can delete (stricter than update)
      // - Team lists: team members can delete (or org admins)
      // - Super admins can delete any
      allow delete: if isAuthenticated()
        && (
          // Owner can delete their lists
          resource.data.ownerId == request.auth.uid
          // Org admin/owner can delete org lists
          || (resource.data.ownerType == "organisation" && resource.data.organisationId != null && isOrgAdminOrOwner(resource.data.organisationId))
          // Team members can delete team lists (or use isOrgAdminOrOwner for stricter control)
          || (resource.data.ownerType == "team" && isInListTeam(resource.data))
          // Super admins can delete any
          || isSuperAdmin()
        );
    }

    // ============================================================================
    // Z-CARDS - Model Composite Cards
    // ============================================================================

    match /zcards/{zcardId} {
      // Read: Model can read their own, creator can read theirs, admins can read any,
      // public/authenticated visibility rules apply for shared links
      allow read: if 
        (isAuthenticated() && resource.data.modelId == request.auth.uid)
        || (isAuthenticated() && resource.data.createdBy == request.auth.uid)
        || (isAuthenticated() && resource.data.visibility == "authenticated")
        || resource.data.visibility == "public"
        || isAdmin();

      // Create: Models can create for themselves, admins can create for any model
      allow create: if isAuthenticated()
        && (
          (isModel() && request.resource.data.modelId == request.auth.uid)
          || isAdmin()
        );

      // Update: Models can update their own, creator can update theirs, admins can update any
      allow update: if isAuthenticated()
        && (
          resource.data.modelId == request.auth.uid
          || resource.data.createdBy == request.auth.uid
          || isAdmin()
        );

      // Delete: Models can delete their own, admins can delete any
      allow delete: if isAuthenticated()
        && (
          resource.data.modelId == request.auth.uid
          || isAdmin()
        );
    }

    // ============================================================================
    // MESSAGING - Threads and Messages
    // ============================================================================

    // Threads collection
    match /threads/{threadId} {
      allow read: if isAuthenticated() && (isParticipant(resource.data) || isAdmin());

      allow create: if false;

      allow update: if isAuthenticated()
        && isParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['muted', 'unread']);

      allow delete: if isSuperAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && (isParticipant(get(/databases/$(database)/documents/threads/$(threadId)).data) || isAdmin());

        allow create: if isAuthenticated()
          && isParticipant(get(/databases/$(database)/documents/threads/$(threadId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 5000;

        allow update, delete: if false;
      }
    }

    // ============================================================================
    // ADMIN LOGS - Audit trail for admin actions
    // ============================================================================

    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================================================
    // ORGANISATIONS - Company/Organisation records
    // ============================================================================

    // Helper: Check if user belongs to a specific organisation
    function isInOrganisation(orgId) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && userData.organisationId == orgId;
    }

    // Helper: Get user's organisation role
    function getUserOrganisationRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organisationRole;
    }

    // Helper: Check if user is organisation owner or admin
    function isOrgAdminOrOwner(orgId) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() &&
        userData.organisationId == orgId &&
        (userData.organisationRole == "owner" || userData.organisationRole == "admin");
    }

    // Helper: Check if user is an account manager for the organisation
    function isOrgAccountManager(orgId) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() &&
        userData.organisationId == orgId &&
        userData.role == "account manager";
    }

    match /organisations/{orgId} {
      // Admins can read all orgs, org members can read their own org
      allow read: if isAuthenticated() &&
        (isAdmin() || isInOrganisation(orgId));

      // Only admins can create organisations
      allow create: if isAdmin();

      // Admins or org account managers can update their organisation
      allow update: if isAdmin() || isOrgAccountManager(orgId);

      // Only super admins can delete organisations
      allow delete: if isSuperAdmin();

      // Teams subcollection
      match /teams/{teamId} {
        // Organisation members can read teams, admins can read all
        allow read: if isInOrganisation(orgId) || isAdmin();

        // Org admins/owners or account managers can create teams
        allow create: if isOrgAdminOrOwner(orgId) || isOrgAccountManager(orgId) || isAdmin();

        // Org admins/owners or account managers can update teams
        allow update: if isOrgAdminOrOwner(orgId) || isOrgAccountManager(orgId) || isAdmin();

        // Org admins/owners or account managers can delete teams
        allow delete: if isOrgAdminOrOwner(orgId) || isOrgAccountManager(orgId) || isAdmin();
      }
    }

    // ============================================================================
    // CMS - Public Website Content Management
    // ============================================================================

    // CMS Pages - Public read for published pages, admin write
    match /cmsPages/{pageId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Pricing Tiers - Public read for published tiers, admin write
    match /pricingTiers/{tierId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Site Content - Public read, admin write
    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Contact Form Submissions - Anyone can create, only admins can read/manage
    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ============================================================================
    // PAYMENTS - Transactions, Withdrawals, Stripe Events
    // ============================================================================

    // Transactions - Users can only read their own, admins can read all
    // Only Cloud Functions can write (enforced by not allowing client writes)
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() &&
        (resource.data.modelId == request.auth.uid ||
         resource.data.clientId == request.auth.uid ||
         isAdmin());
      allow create, update, delete: if false; // Only Cloud Functions can write
    }

    // Withdrawals - Models can only read their own, admins can read all
    // Only Cloud Functions can write
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() &&
        (resource.data.modelId == request.auth.uid || isAdmin());
      allow create, update, delete: if false; // Only Cloud Functions can write
    }

    // Stripe Webhook Events - Internal use only, no client access
    match /stripeWebhookEvents/{eventId} {
      allow read, create, update, delete: if false; // Only Cloud Functions can access
    }

    // Settings collection - System settings
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }
  }
}