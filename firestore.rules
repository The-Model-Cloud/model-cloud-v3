rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is a participant of a thread
    function isParticipant(threadData) {
      return request.auth.uid in threadData.participants;
    }

    // Helper: Get the requesting user's role from their user document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: Check if user is a super admin
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == "super admin";
    }

    // Helper: Check if user is an admin (admin or super admin)
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == "admin" || getUserRole() == "super admin");
    }

    // Helper: Check if user is a model
    function isModel() {
      return isAuthenticated() && getUserRole() == "model";
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSuperAdmin();

      // User notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      }
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();

      // Job applications subcollection
      match /applications/{applicationId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Job invitations subcollection
      match /invitations/{invitationId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }

    // ============================================================================
    // FAVOURITES - Lists and Model Collections
    // ============================================================================

    // Favourite Lists collection
    match /favouriteLists/{listId} {
      allow read: if
        (isAuthenticated() && resource.data.ownerId == request.auth.uid)
        || (isAuthenticated() && resource.data.visibility == "authenticated")
        || resource.data.visibility == "public"
        || isAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      allow delete: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
    }

    // ============================================================================
    // Z-CARDS - Model Composite Cards
    // ============================================================================

    match /zcards/{zcardId} {
      // Read: Model can read their own, creator can read theirs, admins can read any,
      // public/authenticated visibility rules apply for shared links
      allow read: if 
        (isAuthenticated() && resource.data.modelId == request.auth.uid)
        || (isAuthenticated() && resource.data.createdBy == request.auth.uid)
        || (isAuthenticated() && resource.data.visibility == "authenticated")
        || resource.data.visibility == "public"
        || isAdmin();

      // Create: Models can create for themselves, admins can create for any model
      allow create: if isAuthenticated()
        && (
          (isModel() && request.resource.data.modelId == request.auth.uid)
          || isAdmin()
        );

      // Update: Models can update their own, creator can update theirs, admins can update any
      allow update: if isAuthenticated()
        && (
          resource.data.modelId == request.auth.uid
          || resource.data.createdBy == request.auth.uid
          || isAdmin()
        );

      // Delete: Models can delete their own, admins can delete any
      allow delete: if isAuthenticated()
        && (
          resource.data.modelId == request.auth.uid
          || isAdmin()
        );
    }

    // ============================================================================
    // MESSAGING - Threads and Messages
    // ============================================================================

    // Threads collection
    match /threads/{threadId} {
      allow read: if isAuthenticated() && (isParticipant(resource.data) || isAdmin());

      allow create: if false;

      allow update: if isAuthenticated()
        && isParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['muted', 'unread']);

      allow delete: if isSuperAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && (isParticipant(get(/databases/$(database)/documents/threads/$(threadId)).data) || isAdmin());

        allow create: if isAuthenticated()
          && isParticipant(get(/databases/$(database)/documents/threads/$(threadId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 5000;

        allow update, delete: if false;
      }
    }

    // ============================================================================
    // ADMIN LOGS - Audit trail for admin actions
    // ============================================================================
    
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}